# Copy to .env and fill in values. Never commit real secrets.

# --- Local development ---
DATABASE_URL="file:./dev.db"

# --- Railway production (after attaching a Volume) ---
# 1) Railway Dashboard → 캣 service → right-click canvas or Settings
# 2) Add Volume, Mount Path MUST be: /app/data
# 3) Redeploy
#
# App stores:
#   /app/data/prod.db          ← members + listings (SQLite)
#   /app/data/uploads/         ← listing photos
#
# These are set automatically by start-prod when the Volume is attached:
# DATA_DIR=/app/data
# DATABASE_URL=file:/app/data/prod.db
# UPLOAD_DIR=/app/data/uploads

AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="https://rbautotrade.com"
NODE_ENV="production"

# Public contact links (optional overrides)
# NEXT_PUBLIC_CONTACT_PHONE="+82 10-5817-2207"
# NEXT_PUBLIC_WHATSAPP_DEFAULT="821058172207"
# KakaoTalk Open Chat or Channel URL (default: https://open.kakao.com/o/sRRldQFi)
# NEXT_PUBLIC_KAKAOTALK_URL="https://open.kakao.com/o/sRRldQFi"
# Facebook Page / Messenger (defaults: RB AUTO people page)
# NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/people/RB-AUTO/100071434744672/"
# NEXT_PUBLIC_MESSENGER_URL="https://m.me/rbautoscrap"

# Railway injects RAILWAY_PUBLIC_DOMAIN automatically.
# Large backup ZIP restores upload directly to that origin (bypasses Cloudflare).
# Optional explicit override:
# RAILWAY_RESTORE_ORIGIN="https://kat-production-c3d1.up.railway.app"
# How many backup ZIPs to keep on the volume (default 12; full ZIPs include uploads):
# BACKUP_MAX_COUNT=12

# Required on first deploy when no ADMIN user exists yet:
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=use-a-long-unique-password
#
# Optional restore caps (bytes):
# RESTORE_MAX_ZIP_BYTES=42949672960
# RESTORE_MAX_EXTRACT_BYTES=85899345920
