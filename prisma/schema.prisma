generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  AUTHORIZED
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingCategory {
  CAR_LISTINGS
  LIVE_AUCTION
  STAND_BY
  USED_PARTS
}

enum OfferCurrency {
  USD
  KRW
  EUR
}

enum ListingSaleStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  /** Phone / WhatsApp contact for admin follow-up (offers, etc.) */
  phone        String?
  /** Digits-only phone key for duplicate signup checks (unique when set). */
  phoneKey     String?         @unique
  /** Hashed signup IP — used to block multi-account joins from same network. */
  signupIpHash String?
  /** Browser device id cookie at signup. */
  signupDeviceId String?
  role         Role            @default(MEMBER)
  /** Join sets PENDING; existing/seed accounts default to APPROVED. */
  status       AccountStatus   @default(APPROVED)
  /** Admin-only internal memo (shared among admins). */
  adminNote    String?
  createdAt    DateTime        @default(now())
  listings     Listing[]
  purchaseOffers PurchaseOffer[]
  /** Statements this admin created */
  createdStatements TransactionStatement[] @relation("StatementCreatedBy")
  /** Statements where this member is the linked buyer */
  purchasedStatements TransactionStatement[] @relation("StatementBuyer")
  createdOverseasInvoices OverseasInvoice[] @relation("InvoiceCreatedBy")

  @@index([signupIpHash])
  @@index([signupDeviceId])
}

model Listing {
  id               String            @id @default(cuid())
  serialNumber     String            @unique
  title            String
  category         ListingCategory
  /** AVAILABLE = on sale, RESERVED = under contract, SOLD = sold out */
  saleStatus       ListingSaleStatus @default(AVAILABLE)
  year             Int
  make             String
  model            String
  vin              String?
  highlights       String?
  engineMark       String?
  displacement     String?
  transmission     String?
  engineStatus     String?
  odometer         String?
  damages          String?
  /** English translation of damages for public display */
  damagesEn        String?
  fuelType         String?
  exteriorColor    String?
  registrationDate String?
  youtubeUrl       String?
  whatsappNumber   String
  /** Admin-only internal reference (not shown publicly) */
  vehicleNumber    String?
  storageLocation  String?
  inboundDate      String?
  auctionPrice     String?
  incidentalCost   String?
  costPrice        String?
  accumulatedDays  String?
  /** Admin-only detail page view counter (not shown publicly) */
  viewCount        Int             @default(0)
  /**
   * When an admin last opened this listing after offers arrived.
   * Rows stay highlighted until this is at/after the newest offer.
   */
  offersSeenAt     DateTime?
  /** Live Auction deadline; members lose access after this time. */
  auctionEndsAt    DateTime?
  /** Admin “상단” pin; listing-order boost lasts 24 hours from this time. */
  bumpedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  authorId         String
  author           User            @relation(fields: [authorId], references: [id])
  images           ListingImage[]
  purchaseOffers   PurchaseOffer[]
  views            ListingView[]
  /** Primary listing on a statement (first line item) */
  transactionStatements TransactionStatement[]
  statementItems   TransactionStatementItem[]
  overseasInvoiceItems OverseasInvoiceItem[]

  @@index([category, createdAt])
  @@index([saleStatus])
  @@index([authorId])
  @@index([createdAt])
  @@index([viewCount])
  @@index([auctionEndsAt])
}

/** One counted detail view per client IP (admin analytics only). */
model ListingView {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /** Hashed client IP — one view per IP per listing */
  ipHash    String
  createdAt DateTime @default(now())

  @@unique([listingId, ipHash])
  @@index([listingId])
}

/** Admin-issued transaction statement (거래명세서) */
model TransactionStatement {
  id             String        @id @default(cuid())
  statementNo    String        @unique
  /** First selected listing — kept for list preview / legacy rows (null if listing deleted) */
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /** Snapshot of the first line item (legacy + list preview) */
  vehicleLabel   String
  vin            String?
  serialNumber   String
  vehicleNumber  String?
  buyerName      String
  buyerPhone     String?
  buyerAddress   String?
  /** Optional link to a registered member (for purchase analytics). */
  buyerUserId    String?
  buyerUser      User?         @relation("StatementBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  /** Sum of line-item supply amounts */
  amount         String
  currency       OfferCurrency @default(KRW)
  /** true = 10% VAT included in total; false = zero-rated / no VAT */
  includeVat     Boolean       @default(true)
  /** Deposit bank account key: KRW_MAIN | FX_HANA */
  bankAccountId  String        @default("KRW_MAIN")
  issueDate      String
  notes          String?
  createdById    String
  createdBy      User          @relation("StatementCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          TransactionStatementItem[]

  @@index([listingId])
  @@index([issueDate])
  @@index([createdAt])
  @@index([createdById])
  @@index([buyerUserId])
}

/** One vehicle / line on a transaction statement */
model TransactionStatementItem {
  id            String               @id @default(cuid())
  statementId   String
  statement     TransactionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  /** Null when the linked listing was deleted or this is an extra charge line */
  listingId     String?
  listing       Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /** true = service / misc charge (not a vehicle listing) */
  isExtra       Boolean              @default(false)
  vehicleLabel  String
  vin           String?
  serialNumber  String
  vehicleNumber String?
  /** Supply amount for this line (before VAT) */
  amount        String
  sortOrder     Int                  @default(0)

  @@index([statementId, sortOrder])
  @@index([listingId])
}

/** Overseas commercial invoice (영문 인보이스) — separate from Korean 거래명세서 */
model OverseasInvoice {
  id               String        @id @default(cuid())
  invoiceNo        String        @unique
  invoiceDate      String
  terms            String        @default("3days")
  dueDate          String
  company          String?
  consignee        String
  businessNo       String?
  finalDestination String?
  /** Final settlement currency (usually EUR / USD) */
  currency         OfferCurrency @default(EUR)
  /** KRW → foreign currency exchange rate */
  exchangeRate     String
  prepaidLabel     String        @default("100% PREPAID")
  /** Sum of line finalPrice values */
  amount           String
  createdById      String
  createdBy        User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            OverseasInvoiceItem[]

  @@index([invoiceDate])
  @@index([createdAt])
  @@index([createdById])
  @@index([consignee])
}

model OverseasInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     OverseasInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  isExtra     Boolean         @default(false)
  description String
  regNo       String?
  vin         String?
  qty         String          @default("1")
  priceKrw    String
  rate        String
  finalPrice  String
  sortOrder   Int             @default(0)

  @@index([invoiceId, sortOrder])
  @@index([listingId])
}

/** Member purchase interest / bid for a listing */
model PurchaseOffer {
  id        String        @id @default(cuid())
  listingId String
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    String
  currency  OfferCurrency
  /** Hashed client IP — used for abuse analytics */
  ipHash    String
  /** Stable browser device cookie — used for abuse analytics */
  deviceId  String
  createdAt DateTime      @default(now())

  /** App enforces one offer per member per listing. */
  @@index([listingId, userId])
  @@index([listingId, ipHash])
  @@index([listingId, deviceId])
  @@index([listingId, createdAt])
  @@index([userId, createdAt])
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  sortOrder Int     @default(0)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model SiteStats {
  id          String @id @default("main")
  totalVisits Int    @default(0)
  todayVisits Int    @default(0)
  todayDate   String @default("")
}
